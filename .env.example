# Copy to .env.local for local development, then restart Vite.
VITE_API_URL=http://localhost:5000
# On the existing Vercel project, remove VITE_API_URL or set it to /api.
# Set an absolute URL only when intentionally using an external backend.
# If unset, development uses localhost:5000; production uses same-origin /api.

# Optional local stage timing; never logs resume text or credentials.
VITE_ANALYSIS_TIMING=false
