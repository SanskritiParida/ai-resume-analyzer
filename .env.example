# Copy to .env.local for local development, then restart Vite.
VITE_API_URL=http://localhost:5000
# For deployment, set VITE_API_URL to your deployed backend base URL.
# If unset, development uses localhost:5000; production uses the Render fallback.

# Optional local stage timing; never logs resume text or credentials.
VITE_ANALYSIS_TIMING=false
