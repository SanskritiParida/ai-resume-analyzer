# Backend only. Copy to .env and start with npm start (Node 22+).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional bounded per-model deadline (1,000–60,000 ms); default 45,000.
GEMINI_TIMEOUT_MS=45000
# Development only: durations/counts, never resume text or keys.
DEV_ANALYSIS_TIMING=false
